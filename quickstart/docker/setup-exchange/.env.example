# Configuration for setup-exchange scripts
# Shared by all setup scripts (01 through 05).
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Exchange backend location (absolute path to canton-exchange-backend repo)
EXCHANGE_BACKEND_DIR="/path/to/canton-exchange-backend"

# Backend server
BACKEND_PORT=3003
BACKEND_URL="http://localhost:3003"

# LP backend location (absolute path to kairo-dex-lp-backend repo)
# Used by 05-setup-liquidity-provider.sh to generate .env.local
LP_BACKEND_DIR="/path/to/kairo-dex-lp-backend"
LP_BACKEND_PORT=3002
LP_BACKEND_API_KEY=local-lp-api-key

LP_PARTY_HINT="liquidity-provider"
LP_NAME="Local LP"
LP_SELF="true"
LP_TYPE="public"
LP_SUPPORT_TOKENS="Amulet,CBTC"
LP_API="http://localhost:3002"
LP_TOKEN="local-lp-token"

# Canton JSON API endpoints (exposed by local quickstart)
APP_PROVIDER_JSON_API="http://localhost:3975"
APP_USER_JSON_API="http://localhost:2975"
SV_JSON_API="http://localhost:4975"

# Validator API endpoints
APP_PROVIDER_VALIDATOR_API="http://localhost:3903"
APP_USER_VALIDATOR_API="http://localhost:2903"
SV_VALIDATOR_API="http://localhost:4903"

# DAR files to upload (comma-separated)
DAR_FILES="kairo-dex-v3-1.0.0.dar,kairo-dex-simple-escrow-v5-1.0.0.dar,kairo-dex-simple-marketquote-v2-1.0.0.dar,kairo-featured-app-proxies-1.0.1.dar,splice-util-batched-markers-1.0.0.dar,splice-util-token-standard-wallet-1.0.0.dar,utility-collateral-app-v1-1.0.0.dar,utility-commercials-v0-0.4.1.dar,utility-credential-app-v0-0.4.1.dar,utility-credential-v0-0.1.0.dar,utility-registry-app-v0-0.7.0.dar,utility-registry-holding-v0-0.2.1.dar,utility-registry-v0-0.6.0.dar,utility-settlement-app-v1-1.2.0.dar,utility-version-v0-0.0.1.dar"

# Keycloak OAuth2 credentials (from quickstart keycloak module)
KEYCLOAK_APP_PROVIDER_TOKEN_URL="http://keycloak.localhost:8082/realms/AppProvider/protocol/openid-connect/token"
KEYCLOAK_APP_USER_TOKEN_URL="http://keycloak.localhost:8082/realms/AppUser/protocol/openid-connect/token"
KEYCLOAK_APP_PROVIDER_CLIENT_ID="app-provider-validator"
KEYCLOAK_APP_PROVIDER_CLIENT_SECRET="AL8648b9SfdTFImq7FV56Vd0KHifHBuC"
KEYCLOAK_APP_USER_CLIENT_ID="app-user-validator"
KEYCLOAK_APP_USER_CLIENT_SECRET="6m12QyyGl81d9nABWQXMycZdXho6ejEX"

# Keycloak OAuth2 user IDs (for party resolution in oauth2 mode)
KEYCLOAK_APP_PROVIDER_VALIDATOR_USER_ID="c87743ab-80e0-4b83-935a-4c0582226691"
KEYCLOAK_APP_USER_VALIDATOR_USER_ID="97bb6cef-a7a9-410b-ba8c-ada08451a5c9"

# Shared-secret auth config
SHARED_SECRET="unsafe"
SHARED_SECRET_AUDIENCE="https://canton.network.global"
SHARED_SECRET_APP_PROVIDER_USER="ledger-api-user"
SHARED_SECRET_APP_USER_USER="ledger-api-user"
SHARED_SECRET_SV_USER="ledger-api-user"

# Exchange backend database
EXCHANGE_DB_HOST=localhost
EXCHANGE_DB_PORT=5433
EXCHANGE_DB_USERNAME=<your-db-username>
EXCHANGE_DB_PASSWORD="<your-db-password>"
EXCHANGE_DB_NAME=canton_exchange

# Backend JWT secret (default from jwt.config.ts)
BACKEND_JWT_SECRET="your-super-secret-jwt-key"

# FeaturedAppRight registration
FEATURE_APP_RIGHT_TYPE="angelhack"

# Setup user for API calls (register-featured-app-right.sh)
SETUP_USER_ID="00000000-0000-0000-0000-000000000001"
SETUP_USER_EMAIL="setup@local.quickstart"
SETUP_USER_NAME="setup-script"

# Backend .env.local generation: static values
PARTY_ID_PREFIX=kairo
SWAGGER_USERNAME=<your-swagger-username>
SWAGGER_PASSWORD="<your-swagger-password>"
ADMIN_API_KEY=<your-admin-api-key>
WHITELIST_VERIFICATION_CODE=<your-whitelist-code>
CHAINLINK_API_URL="https://api.dataengine.chain.link"
CHAINLINK_API_KEY=placeholder
CHAINLINK_API_SECRET=placeholder
UTILITIES_API_URL="http://localhost:3003"
TRANSFERFACTORY_INTERFACE="#splice-api-token-transfer-instruction-v1:Splice.Api.Token.TransferInstructionV1:TransferFactory"
HOLDING_INTERFACE="#splice-api-token-holding-v1:Splice.Api.Token.HoldingV1:Holding"
TRANSFER_INSTRUCTION_INTERFACE="#splice-api-token-transfer-instruction-v1:Splice.Api.Token.TransferInstructionV1:TransferInstruction"
CBTC_API="https://devnet.dlc.link/attestor-1/app/get-token-standard-contracts"
CBTC_CHAIN=canton-devnet

PROMETHEUS_NODE_API_URL="http://localhost:14011"
PROMETHEUS_NODE_NAME="Local Quickstart"
PROMETHEUS_NODE_JOB=canton

