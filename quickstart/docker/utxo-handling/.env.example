# Configuration for utxo-handling scripts.
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Canton JSON API endpoint for the participant hosting user wallets
PARTICIPANT_JSON_API=http://localhost:2975

# SV JSON API endpoint (for amulet scripts: 03, 06, 08, 10)
SV_JSON_API=http://localhost:4975

# Participant Validator API (for amulet scripts: 03, 06, 08)
PARTICIPANT_VALIDATOR_API=http://localhost:2903

# Exchange backend location (absolute path to canton-exchange-backend repo)
# Required by scripts: 01, 02, 03, 04, 05, 06, 09, 10
EXCHANGE_BACKEND_DIR="/path/to/canton-exchange-backend"

# Setup-exchange directory (for JSON artifacts: cbtc-config.json, cbtc-network-keypair.json, etc.)
# Default: ../setup-exchange (relative to this directory)
# SETUP_EXCHANGE_DIR="../setup-exchange"

# Auth configuration (shared-secret mode)
SHARED_SECRET=unsafe
SHARED_SECRET_AUDIENCE=https://canton.network.global
SHARED_SECRET_USER=ledger-api-user
SHARED_SECRET_SV_USER=ledger-api-user

# User wallet generation (01-generate-user-wallet.sh)
NUM_WALLETS=25
PARTY_HINT=kairo

# Minting configuration (02-request-minting-cbtc.sh)
MINTS_PER_WALLET=20

# Faucet configuration (03-request-faucet-amulet.sh)
TAPS_PER_WALLET=20

# Shared amount range for minting/fauceting
MIN_AMOUNT=100
MAX_AMOUNT=1000
