# UTXO Handling Configuration
# These variables are sourced by all utxo-handling scripts.
# Environment variables take precedence over these defaults.

# Number of user wallets to generate and use
NUM_WALLETS="${NUM_WALLETS:-25}"

# Number of CBTC mint requests per wallet (script 02)
MINTS_PER_WALLET="${MINTS_PER_WALLET:-20}"

# Number of Amulet taps per wallet (script 03)
TAPS_PER_WALLET="${TAPS_PER_WALLET:-20}"

# Amount range for minting/tapping (applies to both CBTC and Amulet)
MIN_AMOUNT="${MIN_AMOUNT:-100}"
MAX_AMOUNT="${MAX_AMOUNT:-1000}"
