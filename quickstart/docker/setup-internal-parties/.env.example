# Configuration for setup-internal-parties scripts
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Canton JSON API endpoint of the participant to allocate parties on
PARTICIPANT_JSON_API="http://localhost:2975"

# Validator Admin API (used to resolve DSO party and poll TransferPreapprovals)
VALIDATOR_API="http://localhost:2903"

# SV JSON API (used by 03-distribute-amulet.sh to fetch AmuletRules + OpenMiningRound)
SV_JSON_API="http://localhost:4975"
SHARED_SECRET_SV_USER="ledger-api-user"

# Number of internal parties to allocate
NUM_PARTIES=10

# Party ID hint prefix — parties will be named <PREFIX>-0, <PREFIX>-1, etc.
PARTY_HINT_PREFIX="trader"

# Shared-secret auth config (for Canton JSON API)
SHARED_SECRET="unsafe"
SHARED_SECRET_AUDIENCE="https://canton.network.global"
SHARED_SECRET_USER="ledger-api-user"

# Set APPEND_PARTIES=true to append new parties to the existing output file
# instead of overwriting it (default: false)
APPEND_PARTIES=false

# Set ONBOARD_ONLY=true to skip party allocation and only create Canton users
# from the existing output file. NUM_PARTIES and APPEND_PARTIES are ignored.
ONBOARD_ONLY=false
