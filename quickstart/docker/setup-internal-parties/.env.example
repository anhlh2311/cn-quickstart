# Configuration for setup-internal-parties scripts
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Canton JSON API endpoint of the participant to allocate parties on
PARTICIPANT_JSON_API="http://localhost:2975"

# Validator Admin API (used to resolve DSO party and poll TransferPreapprovals)
VALIDATOR_API="http://localhost:2903"

# AmuletRules + OpenMiningRound are fetched via scan-proxy on the VALIDATOR_API.
# No separate SV JSON API is needed.

# Number of internal parties to allocate
NUM_PARTIES=10

# Party ID hint prefix — parties will be named <PREFIX>-0, <PREFIX>-1, etc.
PARTY_HINT_PREFIX="your-prefix"

# Canton admin user ID — used to resolve the participant's primary party via
# GET /v2/users/<ADMIN_USER>. In shared-secret mode this is typically
# "ledger-api-user". In OAuth2 mode this is the Keycloak user UUID.
ADMIN_USER="ledger-api-user"

##############################################################################
# Authentication — set AUTH_MODE to "shared-secret" or "oauth2"
##############################################################################
AUTH_MODE="shared-secret"

# Shared-secret auth config (used when AUTH_MODE=shared-secret)
SHARED_SECRET="unsafe"
SHARED_SECRET_AUDIENCE="https://canton.network.global"
SHARED_SECRET_USER="ledger-api-user"

# OAuth2 auth config (used when AUTH_MODE=oauth2)
# Participant token endpoint
OAUTH2_TOKEN_URL="<your-token-url>"
OAUTH2_CLIENT_ID="<your-client-id>"
OAUTH2_CLIENT_SECRET="<your-client-secret>"
OAUTH2_AUDIENCE=""
# Validator API may require a different audience (defaults to OAUTH2_AUDIENCE if not set)
OAUTH2_VALIDATOR_AUDIENCE=""

# Set APPEND_PARTIES=true to append new parties to the existing output file
# instead of overwriting it (default: false)
APPEND_PARTIES=false

# Set ONBOARD_ONLY=true to skip party allocation and only create Canton users
# from the existing output file. NUM_PARTIES and APPEND_PARTIES are ignored.
ONBOARD_ONLY=false
