# Configuration for setup-trading-partner scripts
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Canton JSON API endpoints (exposed by local quickstart)
TRADING_PARTNER_JSON_API="http://localhost:1975"
SV_JSON_API="http://localhost:4975"

# Validator API endpoints
TRADING_PARTNER_VALIDATOR_API="http://localhost:1903"

# DAR files to upload (comma-separated)
# kairo-dex-simple-escrow-v4 + all utility-related DARs
DAR_FILES="kairo-dex-v3-1.0.0.dar,kairo-dex-simple-escrow-v5-1.0.0.dar,kairo-dex-simple-marketquote-v2-1.0.0.dar,kairo-featured-app-proxies-1.0.1.dar,splice-util-batched-markers-1.0.0.dar,splice-util-token-standard-wallet-1.0.0.dar,utility-collateral-app-v1-1.0.0.dar,utility-commercials-v0-0.4.1.dar,utility-credential-app-v0-0.4.1.dar,utility-credential-v0-0.1.0.dar,utility-registry-app-v0-0.7.0.dar,utility-registry-holding-v0-0.2.1.dar,utility-registry-v0-0.6.0.dar,utility-settlement-app-v1-1.2.0.dar,utility-version-v0-0.0.1.dar"

# Auth mode for the trading-partner node: "shared-secret" (default) or "oauth2"
AUTH_MODE="shared-secret"

# Shared-secret auth (trading-partner node — used when AUTH_MODE=shared-secret)
SHARED_SECRET="unsafe"
SHARED_SECRET_AUDIENCE="https://canton.network.global"
SHARED_SECRET_TRADING_PARTNER_USER="ledger-api-user"
SHARED_SECRET_SV_USER="ledger-api-user"

# OAuth2 auth (trading-partner node — used when AUTH_MODE=oauth2)
# OAUTH2_TOKEN_URL="https://keycloak.example.com/realms/trading-partner/protocol/openid-connect/token"
# OAUTH2_CLIENT_ID="trading-partner"
# OAUTH2_CLIENT_SECRET=""
# OAUTH2_AUDIENCE="https://canton.network.global"
# OAUTH2_VALIDATOR_AUDIENCE=""   # defaults to OAUTH2_AUDIENCE if not set
# OAUTH2_ADMIN_USER=""           # Canton JSON API user ID for the admin token (defaults to SHARED_SECRET_TRADING_PARTNER_USER)

# App-provider node auth (used by test-trade-request.sh step 3b and 04-withdraw-allocation.sh)
# Defaults to shared-secret — only override if the exchange's participant uses OAuth2.
# AP_AUTH_MODE="shared-secret"
# AP_SHARED_SECRET_USER="ledger-api-user"
# AP_OAUTH2_TOKEN_URL=""
# AP_OAUTH2_CLIENT_ID=""
# AP_OAUTH2_CLIENT_SECRET=""
# AP_OAUTH2_AUDIENCE=""

# Exchange backend admin credentials (used by 02-request-partner-api-key.sh)
# BACKEND_URL and admin credentials are loaded from setup-exchange/.env,
# but can be overridden here if needed.
# BACKEND_URL="http://localhost:3003"
# BACKEND_ADMIN_USERNAME=""
# BACKEND_ADMIN_PASSWORD=""

# Trader allocation (used by 02-allocate-and-fund-trader.sh)
# PARTY_HINT_PREFIX — prefix for the trader party hint, party is named <prefix>-0 (default: trader)
# FAUCET_AMOUNT     — Amulet (CC) to faucet to the trader on first run (default: 1000000)
# PARTY_HINT_PREFIX="trader"
# FAUCET_AMOUNT="1000000"

# Partner API key override (optional — 03-request-partner-api-key.sh writes to partner-api-key.json)
# Set this to skip the key lookup from partner-api-key.json / liquidity-provider.json
PARTNER_API_KEY=""

# App-provider (exchange) node JSON API URL (used by test-trade-request.sh to query TradeEscrow contracts)
# APP_PROVIDER_JSON_API="http://localhost:3975"

# Set to "true" to skip auto-settlement of lingering TradeEscrow contracts in test-trade-request.sh (step 3b)
# SKIP_ESCROW_SETTLE="true"

# Kairo escrow template IDs — override when upgrading the kairo-dex-simple-escrow package version
# TRADE_PROPOSAL_FACTORY_TEMPLATE_ID="#kairo-dex-simple-escrow-v5:Kairo.Escrow.TradeProposalFactory:TradeProposalFactory"
# TRADE_PROPOSAL_TEMPLATE_ID="#kairo-dex-simple-escrow-v5:Kairo.Escrow.TradeProposal:TradeProposal"
# TRADE_ESCROW_TEMPLATE_ID="#kairo-dex-simple-escrow-v5:Kairo.Escrow.TradeEscrow:TradeEscrow"
