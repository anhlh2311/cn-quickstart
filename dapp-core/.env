## Variables for docker compose substitution
## Container-specific runtime vars are in docker/dapp-core/dapp-core.env
## Override any value locally in .env.local (not committed)

# ── Canton / Splice versions ────────────────────────────────────────────────
DAML_RUNTIME_VERSION=3.4.10
SPLICE_VERSION=0.5.3
DOCKER_NETWORK=quickstart

# ── LocalNet configuration ──────────────────────────────────────────────────
PARTY_HINT=dappcore-local-1
AUTH_MODE=shared-secret
TEST_MODE=off

# ── Profile overrides ──────────────────────────────────────────────────────
# Disable app-user participant (not needed for dapp-core).
# This turns off the app-user nginx template and canton/splice app-user configs.
# SV_PROFILE stays "on" (default from compose.env) — required for localnet bootstrap.
APP_USER_PROFILE=off

# ── dapp-core ───────────────────────────────────────────────────────────────
DAPP_CORE_PORT=3003

# ── Optional features ──────────────────────────────────────────────────────
# OBSERVABILITY_ENABLED=true
# RESOURCE_CONSTRAINTS_ENABLED=true
