# dapp-core environment variables
# Copy to .env.local for local overrides (gitignored)
#
# Variables marked [compose] are used by docker-compose substitution.
# Variables marked [runtime] are read by the dapp-core Node.js process.

# ── Compose-level ─────────────────────────────────────────────────────────────

# [compose] Canton / Splice versions
DAML_RUNTIME_VERSION=3.4.10
SPLICE_VERSION=0.5.3
DOCKER_NETWORK=quickstart

# [compose] LocalNet configuration
PARTY_HINT=dappcore-local-1
AUTH_MODE=shared-secret
TEST_MODE=off

# [compose] Profile overrides
APP_USER_PROFILE=off

# ── dapp-core runtime ─────────────────────────────────────────────────────────

# [runtime] Server
PORT=3003
NODE_ENV=development

# [runtime] Wallet Gateway
GATEWAY_USER_API_URL=http://wallet-gateway:3030/api/v0/user
GATEWAY_DAPP_API_URL=http://wallet-gateway:3030/api/v0/dapp

# [runtime] Canton Participant Ledger API (direct, not through Gateway)
PARTICIPANT_LEDGER_API_URL=http://canton:3975

# [runtime] Splice Validator Internal API
VALIDATOR_API_URL=http://splice:3903/api/validator

# [runtime] Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=cnadmin
DB_PASSWORD=supersafe
DB_NAME=dapp-core

# [runtime] JWT authentication
JWT_SECRET=dapp-core-jwt-secret-change-me
JWT_ACCESS_TOKEN_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# [runtime] Canton auth
CANTON_AUTH_MODE=self_signed
CANTON_UNSAFE_SECRET=unsafe
CANTON_AUDIENCE=https://canton.network.global
CANTON_ADMIN_USER=ledger-api-user
PARTY_ID_PREFIX=dapp-user

# [runtime] Google OAuth (required for auth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Optional features ─────────────────────────────────────────────────────────

# OBSERVABILITY_ENABLED=true
# RESOURCE_CONSTRAINTS_ENABLED=true
