# dapp-core container runtime environment
# Copy to dapp-core.env and fill in secrets before starting.
# dapp-core.env is gitignored — do NOT commit secrets.

PORT=3003
NODE_ENV=development

# Wallet Gateway
GATEWAY_USER_API_URL=http://wallet-gateway:3030/api/v0/user
GATEWAY_DAPP_API_URL=http://wallet-gateway:3030/api/v0/dapp

# Canton Participant Ledger API (direct access for balance queries)
PARTICIPANT_LEDGER_API_URL=http://canton:3975

# Splice Validator Internal API (for faucet + auto-approval)
VALIDATOR_API_URL=http://splice:3903/api/validator

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=cnadmin
DB_PASSWORD=supersafe
DB_NAME=dapp-core

# JWT
JWT_SECRET=dapp-core-jwt-secret-change-me
JWT_ACCESS_TOKEN_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Canton auth (for generating self-signed tokens to Gateway)
CANTON_AUTH_MODE=self_signed
CANTON_UNSAFE_SECRET=unsafe
CANTON_AUDIENCE=https://canton.network.global
CANTON_ADMIN_USER=ledger-api-user
PARTY_ID_PREFIX=dapp-user

# Google OAuth (required — get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
